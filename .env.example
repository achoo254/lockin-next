# apps/server env. Copy to apps/server/.env for dev; production keeps its own file on the server (never in git).
# NODE_ENV=production on the server; development by default.
NODE_ENV=development
# Loopback port of the API (dev: 5310; the web dev server on 5311 proxies /api, /auth, /k/ and /healthz to it).
PORT=5310
# Public origin of the app; the sign-in callback is PUBLIC_URL/auth/callback. Dev: the web dev server.
PUBLIC_URL=http://localhost:5311
# Postgres connection string. Unset: embedded PGlite under .data/pglite (dev only; refused in production).
DATABASE_URL=
# hoandat.com account (auth-next). Sign-in stays off until AUTH_CLIENT_SECRET is set.
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=lockin-web
# Secret of the confidential client lockin-web (the IdP's LOCKIN_WEB_CLIENT_SECRET). At least 32 characters.
AUTH_CLIENT_SECRET=
# AES-256-GCM key (32 bytes, base64) of the stored share links, so a creator can see a plan's link again.
# Required in production; unset in dev/test, a random key is made per process (links then cannot be shown after a
# restart). Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored link unreadable (creators rotate to get a new one); lookups keep working.
SHARE_TOKEN_KEY=
# `pnpm stats --exclude-owner` only (not read by the server): account subs whose plans are left out of the numbers.
STATS_EXCLUDE_SUBS=
